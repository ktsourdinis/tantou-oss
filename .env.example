# ==============================================================================
# ⚡ TANTOU (担当) — HUMAN CAPACITY OS
# Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME=Tantou
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set to true on public showcase/demo instances to enable 1-Click Quick Demo Login and sandbox protections
TANTOU_DEMO_MODE=false
# Enable or disable Branded Custom Domain (CNAME) support and /api/caddy/domain-check
TANTOU_CUSTOM_DOMAINS_ENABLED=false
APP_URL=http://localhost:8085
APP_TIMEZONE=Europe/Athens
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 2. DATABASE & CACHE / QUEUE (MariaDB & Redis)
# ------------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=tantou_db
DB_PORT=3306
DB_DATABASE=tantou
DB_USERNAME=tantou
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=tantou_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------------------------
# 3. LARAVEL REVERB WEBSOCKETS (Live Drag-and-Drop Board Synchronization)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=tantou-app
REVERB_APP_KEY=tantou-key
REVERB_APP_SECRET=tantou-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend Vite variables (Embedded into browser bundle at build time)
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------------------------
# 4. MAIL NOTIFICATIONS (Magic Registration & System Alerts)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 5. TELEGRAM BOT INTEGRATION (Domain Webhooks OR Intranet IP Polling)
# ------------------------------------------------------------------------------
# Bot token and username from @BotFather
TANTOU_TELEGRAM_BOT_TOKEN=
TANTOU_TELEGRAM_BOT_USERNAME=
TANTOU_TELEGRAM_MODE=polling
TANTOU_TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. LOGGING & STORAGE
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
FILESYSTEM_DISK=local

# Optional Master Superadmin & Workspace Auto-Provisioning (leave empty in public repos)
TANTOU_SUPERADMIN_EMAIL=
TANTOU_SUPERADMIN_PASSWORD=
TANTOU_SUPERADMIN_NAME="Konstantinos Tsourdinis"
TANTOU_SUPERADMIN_WORKSPACE="Tantou Team"
TANTOU_SUPERADMIN_SLUG="tantou-team"
